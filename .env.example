# 阿里百炼 API Key（必填）：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 非交互登录（也可用 vsc login --username/--password-stdin）
# NJUPT_USERNAME=
# NJUPT_PASSWORD=

# 可选：覆盖默认模型名（代码默认见 src/njupt_very_smart_class/config.py）
# VSC_MODEL_ASR=
# VSC_MODEL_VISION=
# VSC_MODEL_TEXT=
# VSC_MODEL_OMNI=

# 可选：数据目录，默认 ./data
# VSC_DATA_DIR=
